# ========================================
# HOSTINGER ENVIRONMENT CONFIGURATION
# ========================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# ========================================
# FLASK CONFIGURATION
# ========================================
FLASK_APP=app.py
FLASK_ENV=production
SECRET_KEY=CHANGE-THIS-TO-RANDOM-STRING-min-32-characters-long

# ========================================
# DATABASE CONFIGURATION
# ========================================
# Format: mysql+pymysql://username:password@host/database
DATABASE_URL=mysql+pymysql://u857602025_admin:YOUR_DATABASE_PASSWORD@localhost/u857602025_restaurant

# ========================================
# EMAIL CONFIGURATION (SendGrid)
# ========================================
SENDGRID_API_KEY=your-sendgrid-api-key-here
MAIL_DEFAULT_SENDER=noreply@lemaisonyelolane.com
MAIL_SUPPORT_EMAIL=support@lemaisonyelolane.com

# ========================================
# APPLICATION SETTINGS
# ========================================
DOMAIN=lemaisonyelolane.com
SITE_URL=https://lemaisonyelolane.com
SITE_NAME=Le Maison Yelolane

# ========================================
# REDIS CONFIGURATION (Optional)
# ========================================
# If Hostinger provides Redis, use this:
REDIS_URL=redis://localhost:6379/0
# If no Redis, comment out or leave empty

# ========================================
# SESSION CONFIGURATION
# ========================================
SESSION_TYPE=filesystem
PERMANENT_SESSION_LIFETIME=86400

# ========================================
# SECURITY SETTINGS
# ========================================
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# ========================================
# FILE UPLOAD SETTINGS
# ========================================
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=static/uploads

# ========================================
# LOGGING
# ========================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ========================================
# NOTES:
# ========================================
# 1. Replace YOUR_DATABASE_PASSWORD with actual password
# 2. Generate SECRET_KEY using: python -c "import secrets; print(secrets.token_hex(32))"
# 3. Get SendGrid API key from: https://sendgrid.com
# 4. Make sure .env file has proper permissions: chmod 600 .env
